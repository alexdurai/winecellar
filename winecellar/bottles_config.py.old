import yaml
from pathlib import Path

class BottlesConfig:
    KEYMAP = {
        "features": "Features",
        "graphics": "Graphics",
        "environment": "Environment",
    }

    def __init__(self, bottle_dir: Path):
        self.path = bottle_dir / "config.yml"

        with open(self.path) as f:
            self.data = yaml.safe_load(f)

    def _merge(self, dst: dict, src: dict):
        for k, v in src.items():
            if isinstance(v, dict):
                dst.setdefault(k, {})
                self._merge(dst[k], v)
            else:
                dst[k] = v

    def apply_sections(self, cfg):
        for src, dst in self.KEYMAP.items():
            if cfg.section(src):
                self.data.setdefault(dst, {})
                self._merge(self.data[dst], cfg.section(src))

    def apply_dll_overrides(self, overrides: dict):
        self.data.setdefault("DllOverrides", {})
        mode = overrides["mode"]
        for dll in overrides["dlls"]:
            self.data["DllOverrides"][dll] = mode

    def save(self):
        with open(self.path, "w") as f:
            yaml.safe_dump(self.data, f, sort_keys=False)
